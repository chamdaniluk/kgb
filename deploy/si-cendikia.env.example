# Salin ke /etc/si-cendikia/si-cendikia.env dan isi melalui secret manager.
ADDR=127.0.0.1:8080
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/si_cendikia?sslmode=verify-full
MIGRATIONS_DIR=/opt/si-cendikia/migrations
FILE_ROOT=/var/lib/si-cendikia/files
SESSION_SECRET=GANTI_DENGAN_RANDOM_MINIMAL_32_KARAKTER
SECURE_COOKIE=true

# Opsional: hanya untuk provisioning awal. Hapus setelah admin resmi dibuat.
# BOOTSTRAP_ADMIN_USERNAME=admin.tidak-bentrok
# BOOTSTRAP_ADMIN_PASSWORD=ISI_DARI_SECRET_MANAGER
# BOOTSTRAP_ADMIN_NAME=Admin Sistem

# Integrasi eSign Kominfo.
# ESIGN_BASE_URL=https://esign-dev.layanan.go.id
# ESIGN_USERNAME=ISI_DARI_SECRET_MANAGER
# ESIGN_PASSWORD=ISI_DARI_SECRET_MANAGER

# Optional PDF renderer settings.
# PDF_BIN=/usr/bin/wkhtmltopdf
# PDF_TMP_DIR=/var/lib/si-cendikia/pdf-tmp

# Konektor SIPP ASN (sumber utama data induk; tanpa kredensial).
# SIPPASN_BASE_URL=https://sippasn.grobogan.go.id
# SIPPASN_TIMEOUT_SECONDS=60
# SIPPASN_SNAPSHOT_TTL=6h
# SIPPASN_NIGHTLY_SYNC=true
# SIPPASN_NIGHTLY_INTERVAL=24h
# SIPPASN_NIGHTLY_ACTOR_ID=

# Pemberitahuan masa uji coba internal di beranda (default: 7 hari dari start).
# TRIAL_UNTIL=2026-09-11 (cadangan; diabaikan bila admin sudah mengatur lewat dasbor)

# Do not commit the populated file.
noop=1

# Health endpoints:
# GET /healthz
# GET /readyz

# File permissions: 0640, owned by root:si-cendikia or si-cendikia:si-cendikia.

# Backup paths are configured in deploy/backup-si-cendikia.example.sh.
